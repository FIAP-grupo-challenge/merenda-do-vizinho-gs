{
  "name": "merenda-do-vizinho-app",
  "version": "1.0.0",
  "private": true,
  "description": "App web do Merenda do Vizinho: agricultor, cooperativa e prefeitura no PNAE",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "build": "vite build",
    "prestart": "npm run build",
